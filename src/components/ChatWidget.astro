---
// Floating contact chat widget. Renders the button and the chat window
// shell; the interactive module (chat/widget.ts, with its CSS) loads
// lazily on first open, so the widget costs the page nothing until a
// visitor actually opens it. The window starts hidden; the loader
// below opens it immediately on click, then hands control to the
// widget once the module arrives.
import type { Lang } from '../config/site';
import { CONTACT } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Public endpoint of the contact Worker (set as the CONTACT_API_URL
// repository variable; empty until the Worker is deployed — the widget
// then shows a mailto fallback instead of failing silently).
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || '';
// Widget stylesheet (public/chat-widget.css), base-aware. Passed to
// the widget so it can inject the <link> on first open.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const cssUrl = `${base}chat-widget.css`;
---

<div class="chat-widget" data-chat-widget data-lang={lang} data-api-url={apiUrl} data-email={CONTACT.email} data-css-url={cssUrl}>
  <button
    class="chat-toggle"
    data-chat-toggle
    type="button"
    aria-label={lang === 'id' ? 'Buka obrolan' : 'Open chat'}
    aria-expanded="false"
    aria-controls="chat-window"
  >
    <svg class="chat-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
    <svg class="chat-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>

  <section
    class="chat-window"
    id="chat-window"
    data-chat-window
    role="dialog"
    aria-label={lang === 'id' ? 'Ngobrol dengan Alzam' : 'Chat with Alzam'}
    hidden
  >
    <header class="chat-header">
      <div>
        <h2 data-chat-title></h2>
        <p data-chat-subtitle></p>
      </div>
      <div class="chat-header-actions">
        <div class="chat-lang" role="group" aria-label="Language / Bahasa">
          <button type="button" data-chat-lang="en">EN</button>
          <button type="button" data-chat-lang="id">ID</button>
        </div>
        <button class="chat-close" data-chat-close type="button" aria-label={lang === 'id' ? 'Tutup obrolan' : 'Close chat'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
    </header>

    <div class="chat-messages" data-chat-messages aria-live="polite"></div>

    <form class="chat-form" data-chat-form>
      <input class="chat-honeypot" data-chat-honeypot type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input data-chat-input type="text" autocomplete="off" />
      <button class="chat-send" data-chat-send type="submit" aria-label={lang === 'id' ? 'Kirim' : 'Send'}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </form>

    <div class="chat-confirm" data-chat-confirm hidden>
      <button class="chat-btn" data-chat-confirm-send type="button"></button>
      <button class="chat-btn chat-btn-ghost" data-chat-start-over type="button"></button>
    </div>
  </section>
</div>

<script>
  // Tiny loader: only the toggle wiring lives here. The full widget
  // (and its CSS) loads on first open.
  const root = document.querySelector('[data-chat-widget]');
  const toggle = root?.querySelector('[data-chat-toggle]');
  const win = root?.querySelector('[data-chat-window]');
  const messages = root?.querySelector('[data-chat-messages]');
  let loadPromise = null;

  const loadWidget = () => {
    if (!loadPromise) {
      loadPromise = import('./chat/widget.ts')
        .then((m) => {
          if (!root) throw new Error('chat root missing');
          return new m.ChatWidget(root, {
            lang: root.dataset.lang === 'id' ? 'id' : 'en',
            apiUrl: root.dataset.apiUrl || '',
            email: root.dataset.email || '',
            cssUrl: root.dataset.cssUrl || '',
          });
        })
        .catch((err) => {
          // The chunk failed to load (offline, blocked): say so plainly
          // instead of leaving an empty window.
          console.error('Chat widget failed to load:', err);
          if (messages) {
            const note = document.createElement('div');
            note.className = 'chat-bubble chat-bubble-bot';
            note.textContent =
              (root?.dataset.lang === 'id'
                ? 'Obrolan tidak bisa dimuat. Silakan kirim email langsung.'
                : "The chat couldn't load. Please email directly instead.");
            messages.appendChild(note);
          }
          throw err;
        });
    }
    return loadPromise;
  };

  toggle?.addEventListener('click', async () => {
    const wasHidden = !!win?.hidden;
    if (wasHidden) {
      win.hidden = false;
      root?.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
    }
    toggle.disabled = true;
    try {
      const widget = await loadWidget();
      widget.toggle();
    } catch {
      // The module never arrived: the toggle still closes the shell,
      // so the visitor is never stuck with an open empty window.
      if (!wasHidden && win) {
        win.hidden = true;
        root?.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    } finally {
      toggle.disabled = false;
    }
  });
</script>
