---
interface Props {
  fill: string;
}
const { fill } = Astro.props;
---
<svg
  class="wave wave-secondary"
  viewBox="0 0 2880 90"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    d="M0,28 C240,70 480,8 720,24 C960,54 1200,-14 1440,28 L1440,90 L0,90 Z"
    fill="var(--wave-muted)"
  />
  <path
    d="M0,28 C240,70 480,8 720,24 C960,54 1200,-14 1440,28 L1440,90 L0,90 Z"
    fill="var(--wave-muted)"
    transform="translate(1440 0)"
  />
</svg>
<svg
  class="wave"
  viewBox="0 0 2880 90"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path
    d="M0,48 C240,90 480,0 720,36 C960,72 1200,6 1440,48 L1440,90 L0,90 Z"
    fill={fill}
  />
  <path
    d="M0,48 C240,90 480,0 720,36 C960,72 1200,6 1440,48 L1440,90 L0,90 Z"
    fill={fill}
    transform="translate(1440 0)"
  />
</svg>
