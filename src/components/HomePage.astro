---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Wave from './Wave.astro';
import { SITE_NAME, TAGLINE, PROJECTS_HEADING, COPY, CONTACT, type Lang } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const imageSrc = (image: string) =>
  image.startsWith('http') ? image : `${base}${image.replace(/^\/+/, '')}`;
const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.data.title.localeCompare(b.data.title);
});
const featured = projects.filter((p) => p.data.featured);
const earlier = projects.filter((p) => !p.data.featured);

const contactLinks = [
  CONTACT.email
    ? { label: 'Email', href: `mailto:${CONTACT.email}`, icon: 'email' as const }
    : null,
  CONTACT.github
    ? { label: 'GitHub', href: CONTACT.github, icon: 'github' as const }
    : null,
  CONTACT.linkedin
    ? { label: 'LinkedIn', href: CONTACT.linkedin, icon: 'linkedin' as const }
    : null,
  CONTACT.whatsapp
    ? { label: 'WhatsApp', href: CONTACT.whatsapp, icon: 'whatsapp' as const }
    : null,
].filter(
  (x): x is { label: string; href: string; icon: 'email' | 'github' | 'linkedin' | 'whatsapp' } =>
    x !== null,
);
---
<Base
  lang={lang}
  title={`${SITE_NAME} — ${TAGLINE[lang]}`}
  description={TAGLINE[lang]}
>
  <section class="hero" id="top">
    <div class="wrap">
      <p class="eyebrow reveal" style="--d: 0s">{t.heroEyebrow}</p>
      <h1 class="reveal" style="--d: 0.1s">{TAGLINE[lang]}</h1>
      <p class="hero-intro reveal" style="--d: 0.15s">{t.heroIntro}</p>
      <div class="hero-cta reveal" style="--d: 0.2s">
        <a class="btn btn-solid" href="#projects">{t.heroCtaProjects}</a>
        <a class="btn btn-outline" href="#contact">{t.heroCtaContact}</a>
      </div>
    </div>
  </section>

  <section class="section section-pearl section-about" id="about">
    <div class="about-grid">
      <div class="about-copy">
        <h2 class="reveal">{t.aboutHeading}</h2>
        {t.aboutBody.map((para, i) => (
          <p class="reveal" style={`--d: ${i * 0.1}s`}>
            {para}
          </p>
        ))}
      </div>
      <div class="about-backdrop" aria-hidden="true">
        <picture>
          <source
            type="image/webp"
            srcset={`${imageSrc('images/about-silhouette.webp')} 600w, ${imageSrc('images/about-silhouette-2x.webp')} 1080w`}
            sizes="(max-width: 760px) 100vw, 46vw"
          />
          <img
            src={imageSrc('images/about-silhouette.jpg')}
            srcset={`${imageSrc('images/about-silhouette.jpg')} 600w, ${imageSrc('images/about-silhouette-2x.jpg')} 1080w`}
            sizes="(max-width: 760px) 100vw, 46vw"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </section>

  <div class="wave-wrap wave-on-pearl about-wave"><Wave fill="var(--green)" /></div>
  <section class="section section-green" id="projects">
    <div class="wrap">
      <h2 class="reveal">{PROJECTS_HEADING[lang]}</h2>
    </div>
    <div
      class="carousel reveal"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label={t.navProjects}
    >
      <div class="carousel-viewport">
        <div class="carousel-track">
          {
            featured.map((p, i) => (
              <article
                class={`card slide${i === 0 ? ' active' : ''}`}
                data-slide
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} / ${featured.length}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                {p.data.image ? (
                  <div class="slide-media">
                    <img
                      src={imageSrc(p.data.image)}
                      alt={lang === 'en' ? p.data.title : p.data.titleId}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="image-mark" aria-hidden="true">
                      © Alzam A.
                    </span>
                  </div>
                ) : (
                  <div class="card-mark" aria-hidden="true">
                    {p.data.title.charAt(0)}
                  </div>
                )}
                <h3>{lang === 'en' ? p.data.title : p.data.titleId}</h3>
                <p>{lang === 'en' ? p.data.description : p.data.descriptionId}</p>
                <div class="tags">
                  {(lang === 'en' ? p.data.tags : p.data.tagsId).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <div class="card-links">
                  {p.data.live && (
                    <a href={p.data.live} target="_blank" rel="noreferrer">
                      {lang === 'en' ? 'Visit site' : 'Kunjungi situs'}
                    </a>
                  )}
                  {p.data.repo && (
                    <a href={p.data.repo} target="_blank" rel="noreferrer">
                      {lang === 'en' ? 'Repository' : 'Repositori'}
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
      {
        featured.length > 1 && (
          <div class="carousel-controls">
            <button
              class="carousel-arrow"
              data-prev
              aria-label={lang === 'en' ? 'Previous project' : 'Proyek sebelumnya'}
            >
              <span aria-hidden="true">‹</span>
            </button>
            <div class="carousel-dots" aria-label={lang === 'en' ? 'Choose project' : 'Pilih proyek'}>
              {featured.map((p, i) => (
                <button
                  class="carousel-dot"
                  data-dot={i}
                  aria-label={`${lang === 'en' ? 'Go to project' : 'Ke proyek'} ${lang === 'en' ? p.data.title : p.data.titleId}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                />
              ))}
            </div>
            <button
              class="carousel-arrow"
              data-next
              aria-label={lang === 'en' ? 'Next project' : 'Proyek berikutnya'}
            >
              <span aria-hidden="true">›</span>
            </button>
          </div>
        )
      }
    </div>
    {
      earlier.length > 0 && (
        <div class="wrap">
          <div class="earlier-work reveal">
            <h3>{t.earlierHeading}</h3>
            <ul class="earlier-list">
              {earlier.map((p) => {
                const note = lang === 'en' ? p.data.earlierNote : p.data.earlierNoteId;
                return (
                  <li>
                    <span class="earlier-title">
                      {lang === 'en' ? p.data.title : p.data.titleId}
                    </span>
                    {note && <span class="earlier-note">{note}</span>}
                    {p.data.live && (
                      <a href={p.data.live} target="_blank" rel="noreferrer">
                        {lang === 'en' ? 'Visit site' : 'Kunjungi situs'}
                      </a>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      )
    }
  </section>

  <section class="section section-green" id="contact">
    <div class="wrap wrap-narrow">
      <div class="contact-card reveal">
        <h2 class="reveal">{t.contactHeading}</h2>
        <p class="reveal" style="--d: 0.1s">{t.contactBody}</p>
        {
          contactLinks.length > 0 ? (
            <div class="contact-links reveal" style="--d: 0.2s">
              {contactLinks.map((c) => (
                <a
                  class="contact-icon"
                  href={c.href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={c.label}
                >
                  {c.icon === 'email' && (
                    <svg
                      viewBox="0 0 24 24"
                      width="24"
                      height="24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                  )}
                  {c.icon === 'github' && (
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </svg>
                  )}
                  {c.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                  )}
                  {c.icon === 'whatsapp' && (
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <p class="contact-empty reveal" style="--d: 0.2s">{t.contactEmpty}</p>
          )
        }
      </div>
    </div>
  </section>
</Base>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !reduceMotion) {
    const ro = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            ro.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    revealEls.forEach((el) => ro.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('in-view'));
  }

  const carousel = document.querySelector('[data-carousel]');
  if (carousel) {
    const viewport = carousel.querySelector('.carousel-viewport');
    const track = carousel.querySelector('.carousel-track');
    const slides = [...carousel.querySelectorAll('[data-slide]')];
    const prevBtn = carousel.querySelector('[data-prev]');
    const nextBtn = carousel.querySelector('[data-next]');
    const dots = [...carousel.querySelectorAll('[data-dot]')];
    let index = 0;
    let timer = null;
    let ready = false;
    let visible = false;
    let paused = false;
    carousel.classList.add('is-js');

    const step = () => {
      const first = slides[0];
      if (!first) return 0;
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return first.offsetWidth + gap;
    };
    const layout = () => {
      if (!viewport || !track) return;
      const slideWidth = slides[0]?.offsetWidth || 0;
      const off = viewport.clientWidth / 2 - slideWidth / 2 - index * step();
      track.style.transform = `translateX(${off}px)`;
    };
    const setActive = (i) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((slide, k) => {
        const active = k === index;
        slide.classList.toggle('active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.querySelectorAll('a').forEach((a) =>
          a.setAttribute('tabindex', active ? '0' : '-1'),
        );
      });
      dots.forEach((dot, k) => {
        dot.classList.toggle('active', k === index);
        dot.setAttribute('aria-current', k === index ? 'true' : 'false');
      });
      layout();
    };
    const schedule = () => {
      clearTimeout(timer);
      if (slides.length < 2 || reduceMotion || paused || !ready || !visible) return;
      timer = setTimeout(() => {
        setActive(index + 1);
        schedule();
      }, 3000);
    };
    const tryStart = () => schedule();

    const imgs = [...carousel.querySelectorAll('img')];
    const waitImgs = Promise.all(
      imgs.map(
        (img) =>
          img.complete ||
          new Promise((resolve) => {
            img.addEventListener('load', resolve, { once: true });
            img.addEventListener('error', resolve, { once: true });
          }),
      ),
    );
    Promise.race([waitImgs, new Promise((resolve) => setTimeout(resolve, 2500))]).then(
      () => {
        ready = true;
        tryStart();
      },
    );

    const so = new IntersectionObserver(
      (entries) => {
        visible = entries[0].isIntersecting;
        if (visible) tryStart();
        else clearTimeout(timer);
      },
      { threshold: 0.2 },
    );
    so.observe(carousel);

    carousel.addEventListener('mouseenter', () => {
      paused = true;
      clearTimeout(timer);
    });
    carousel.addEventListener('mouseleave', () => {
      paused = false;
      tryStart();
    });
    carousel.addEventListener('focusin', () => {
      paused = true;
      clearTimeout(timer);
    });
    carousel.addEventListener('focusout', () => {
      paused = false;
      tryStart();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(timer);
      else tryStart();
    });

    prevBtn?.addEventListener('click', () => {
      setActive(index - 1);
      schedule();
    });
    nextBtn?.addEventListener('click', () => {
      setActive(index + 1);
      schedule();
    });
    dots.forEach((dot, k) =>
      dot.addEventListener('click', () => {
        setActive(k);
        schedule();
      }),
    );
    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        setActive(index - 1);
        schedule();
      }
      if (event.key === 'ArrowRight') {
        setActive(index + 1);
        schedule();
      }
    });

    let startX = null;
    viewport?.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    viewport?.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) {
        setActive(index + (dx < 0 ? 1 : -1));
        schedule();
      }
    });

    window.addEventListener('resize', layout);
    setActive(0);
  }
</script>
