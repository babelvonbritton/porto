---
import { FOOTER_NAME, COPY, type Lang } from '../config/site';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const t = COPY[lang];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={lang === 'en' ? base : `${base}id/`}>
          <img
            src={`${base}images/techne-logo.png`}
            alt="Techne"
            width="1254"
            height="622"
          />
        </a>
        <nav class="site-nav" aria-label="Main">
          <button
            class="menu-button"
            type="button"
            popovertarget="site-menu"
            popovertargetaction="toggle"
            aria-controls="site-menu"
            aria-expanded="false"
            aria-label="Menu"
          >
            <svg class="icon-open" aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
            <svg class="icon-close" aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="6" y1="6" x2="18" y2="18" />
              <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
          </button>
          <ul id="site-menu" class="site-menu" popover="auto">
            <li><a href="#projects">{t.navProjects}</a></li>
            <li><a href="#about">{t.navAbout}</a></li>
            <li><a href="#contact">{t.navContact}</a></li>
          </ul>
        </nav>
        <div class="lang-switch" aria-label="Language">
          <a href={base} class={lang === 'en' ? 'active' : ''}>EN</a>
          <span aria-hidden="true">|</span>
          <a href={`${base}id/`} class={lang === 'id' ? 'active' : ''}>ID</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {year} {FOOTER_NAME}. {t.footerRights}</p>
      </div>
    </footer>

    <ChatWidget lang={lang} />

    <script is:inline>
      (function () {
        var header = document.querySelector('.site-header');
        var menu = document.getElementById('site-menu');
        var button = header.querySelector('.menu-button');
        if (!header || !menu || !button) return;
        var supportsPopover = Object.hasOwn(HTMLElement.prototype, 'popover');
        var wideQuery = window.matchMedia('(min-width: 641px)');

        // Syncs the button state with whether the menu is open.
        function setButtonState(open) {
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        // Closes the menu in the native popover path and in the fallback path.
        function closeMenu() {
          if (supportsPopover) {
            if (menu.matches(':popover-open')) menu.hidePopover();
          } else {
            menu.classList.remove('is-open');
          }
          setButtonState(false);
        }

        // Picks the inline layout on wide screens, the popover menu on narrow ones.
        function syncLayout() {
          var wasOpen = supportsPopover
            ? menu.matches(':popover-open')
            : menu.classList.contains('is-open');
          if (wideQuery.matches) {
            header.classList.add('is-wide');
            if (supportsPopover) menu.removeAttribute('popover');
            closeMenu();
            return;
          }
          header.classList.remove('is-wide');
          if (supportsPopover) {
            menu.setAttribute('popover', 'auto');
            if (wasOpen) menu.showPopover();
          } else if (wasOpen) {
            menu.classList.add('is-open');
          }
          setButtonState(wasOpen);
        }

        if (supportsPopover) {
          menu.addEventListener('toggle', function () {
            setButtonState(menu.matches(':popover-open'));
          });
          menu.addEventListener('click', function (event) {
            if (event.target.closest('a')) closeMenu();
          });
        } else {
          document.documentElement.classList.add('no-popover');
          button.addEventListener('click', function () {
            setButtonState(menu.classList.toggle('is-open'));
          });
          menu.addEventListener('click', function (event) {
            if (event.target.closest('a')) closeMenu();
          });
          document.addEventListener('click', function (event) {
            if (menu.classList.contains('is-open') && !event.target.closest('.site-header')) closeMenu();
          });
          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeMenu();
          });
        }

        syncLayout();
        if (wideQuery.addEventListener) wideQuery.addEventListener('change', syncLayout);
        else wideQuery.addListener(syncLayout);
      })();
    </script>
  </body>
</html>
